# توکن ربات از @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# آیدی عددی ادمین‌ها (با کاما جدا شود) — از @userinfobot بگیرید
ADMIN_IDS=111111111,222222222
# کانال عمومی: @mychannel   |   کانال خصوصی: -1001234567890
CHANNEL_ID=@mychannel
# فقط برای کانال خصوصی لازم است (لینک دعوت)
CHANNEL_LINK=
# تعداد توکن به ازای هر رفرال
REF_REWARD=1
# زبان پیش‌فرض: fa یا en
DEFAULT_LANG=fa
# مسیر دیتابیس — روی Railway یک Volume در مسیر /data بسازید
DB_PATH=/data/bot.db
# منطقه زمانی نمایش زمان چالش‌ها
TIMEZONE=Asia/Tehran
